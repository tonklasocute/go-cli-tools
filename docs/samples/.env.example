# orders-api — environment schema checked by envcheck.
# Each inline comment lists the rules for its key; full-line comments are docs.

# --- Server ---
APP_NAME=orders-api          # required,min=3,max=32
PORT=3000                    # required,int,min=1,max=65535
HOST=0.0.0.0
LOG_LEVEL=info               # enum=debug|info|warn|error
DEBUG=false                  # bool
REQUEST_TIMEOUT=2.5          # float,min=0.1,max=60

# --- Data ---
DATABASE_URL=                # required,url,secret
REDIS_URL=                   # url
DB_POOL_SIZE=10              # int,min=1,max=100

# --- Auth & integrations ---
API_KEY=                     # required,secret,regex=^ak_(live|test)_[A-Za-z0-9]{24,}$
JWT_SECRET=                  # required,secret,min=32
ADMIN_EMAIL=                 # email
RELEASE=                     # regex=^v\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?$
